{
	"name": "weather-app",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"keywords": [
		"weather"
	],
	"description": "A Weather app",
	"repository": "github:eldarlrd/weather-app",
	"homepage": "https://eldarlrd.is-a.dev/weather-app",
	"author": "Eldar Paşazadə <eldarlrd@pm.me> (https://eldarlrd.is-a.dev)",
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "vite --open",
		"bundle": "tsc -b && vite build",
		"serve": "vite preview",
		"deployer": "pnpm build && gh-pages -b deploy -m 'build(prod): deployment' -d dist",
		"fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
		"orphans": "knip --cache --no-exit-code"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"dependencies": {
		"date-fns": "^4.4.0",
		"lit": "^3.3.3",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/bun": "1.4.2",
		"gh-pages": "^6.3.0",
		"typescript": "^7.0.2",
		"knip": "^6.35.1",
		"lefthook": "^2.1.12",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1"
	}
}
